# Absolute path to the development theme directory inside a test Vault.
# The folder must be a real directory, not a symbolic link. Deployment replaces
# only theme.css and manifest.json and preserves every other Vault file.
OBSIDIAN_THEME_DIR=/absolute/path/to/vault/.obsidian/themes/Pixel
# Deployment is intentionally locked to Pixel's dedicated dev-test Vault.
OBSIDIAN_VAULT_ID=773da17a65bacca8
