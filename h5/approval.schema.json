{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/h5/approval.schema.json",
  "title": "Pixel H5 exact-artifact approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "claim",
    "artifact",
    "source",
    "environment",
    "reviewedAt",
    "reviewer",
    "objectiveResults",
    "gates",
    "h5Identity",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "pixel-h5-exact-artifact-approval" },
    "claim": { "const": "Approved" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeCssSha256"],
      "properties": {
        "themeCssSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedCommit", "dirty", "implementer"],
      "properties": {
        "reviewedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": { "const": false },
        "implementer": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureVersion",
        "rubricVersion",
        "requiredObsidianVersion"
      ],
      "properties": {
        "fixtureVersion": { "$ref": "#/$defs/semver" },
        "rubricVersion": { "$ref": "#/$defs/semver" },
        "requiredObsidianVersion": { "$ref": "#/$defs/semver" }
      }
    },
    "reviewedAt": { "$ref": "#/$defs/timestamp" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "const": "visual-owner" }
      }
    },
    "objectiveResults": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/passResult",
          "properties": { "check": { "const": "package-identity" } }
        },
        {
          "$ref": "#/$defs/passResult",
          "properties": { "check": { "const": "runtime-environment" } }
        },
        {
          "$ref": "#/$defs/passResult",
          "properties": { "check": { "const": "fixture-matrix" } }
        },
        {
          "$ref": "#/$defs/passResult",
          "properties": { "check": { "const": "topology-observations" } }
        },
        {
          "$ref": "#/$defs/passResult",
          "properties": { "check": { "const": "transition-observations" } }
        }
      ],
      "items": false
    },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "workspace-composition" } }
        },
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "material-depth" } }
        },
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "semantic-color" } }
        },
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "typography-geometry" } }
        },
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "hardware-identity" } }
        },
        {
          "$ref": "#/$defs/gateResult",
          "properties": { "gate": { "const": "four-state-continuity" } }
        }
      ],
      "items": false
    },
    "h5Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": { "const": "Approved" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "signedBy", "signedAt", "statement"],
      "properties": {
        "type": { "const": "named-visual-owner" },
        "signedBy": { "type": "string", "minLength": 1 },
        "signedAt": { "$ref": "#/$defs/timestamp" },
        "statement": {
          "const": "I am the authorized visual owner and approve this exact Pixel H5 artifact."
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "passResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "result"],
      "properties": {
        "check": { "type": "string" },
        "result": { "const": "Pass" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "region", "finding"],
      "properties": {
        "fixtureId": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "finding": { "type": "string", "minLength": 1 }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "decision", "findings"],
      "properties": {
        "gate": { "type": "string" },
        "decision": { "const": "Pass" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  }
}
